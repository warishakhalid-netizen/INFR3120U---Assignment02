<%- include partials/header.ejs %>
<%- include partials/main_nav.ejs %>

<!-- Used Bootstrap V6.0 to create a set container with margins -->
<main class = "text-center container my-5">
<!-- Contact Me page heading within h1-->
    <h1 class = "text-center mb-5"> CONTACT ME!🌷</h1>
<!--Use the p tag to create a subtext below the header-->
    <p class = "text-center mb-3">
<!-- Use Font Awesome heart logo to add some personalization and styling-->
        <i class="fa-solid fa-heart fa-lg" style="color: rgb(174, 139, 169);"></i>
        Have a question OR want to connect? Feel free to reach out!
        <i class="fa-solid fa-heart fa-lg" style="color: rgb(174, 139, 169);"></i>
    </p>  
    
<!--Use Bootstrap version 4.0 to create to text input fields for first and last name-->
<form action="mailto:warisha.khalid@ontariotechu.net?subject=Portfolio%20Contact%20Form"
      method="post"
      enctype="text/plain"
      name="contactForm">

  <div class="row my-5">
    <div class="col">
      <input type="text" class="form-control" placeholder="First name" id="firstName" name="firstName" required>
    </div>
    <div class="col">
      <input type="text" class="form-control" placeholder="Last name" id="lastName" name="lastName" required>
    </div>
  </div>


<!-- Use Bootstrap version 6.0 to create a space for user to input email address -->
<div class="form-field mb-3">
  <label for="exampleFormControlInput1" class="form-label">Email address:</label>
  <input type="email" class="form-control" id="email" placeholder="name@example.com" name="email" required>
  <div class="form-text">
    We will never share your email with anyone else.
  </div>
</div>

<!-- Use Bootstrap version 5.0 to create a phone number input field-->
  <div class="col my-5">
      <label for ="cell"> Cell Number: </label>
      <input type="tel" class="form-control" placeholder="123-456-7890" id="cell" name="cell" required>
  </div>

<!-- Use Bootstrap version 5.0 to create a text-area for any user comments-->
<div class="mb-3">
  <label for="comments" class="form-label">Comments?</label>
  <textarea class="form-control" id="comments" name="comments" rows="3"></textarea>
</div>


<!--Use Bootstrap version 4.0 to create a submit & reset button-->
<div class="d-grid gap-4 d-md-block my-3">
  <button class="btn btn-primary btn-lg" type="button">Submit</button>
  <button class="btn btn-secondary btn-lg" type="button">Reset</button>
</div>

</form>


</main>



<%- include partials/footer.ejs %>